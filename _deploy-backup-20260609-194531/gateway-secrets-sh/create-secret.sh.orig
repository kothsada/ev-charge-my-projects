#!/bin/bash
# Cloud GCP — panda-ev-gateway-services (Production-ready)
# Usage: ./create-secret.sh <namespace>

set -euo pipefail

NAMESPACE=${1:-""}
if [ -z "$NAMESPACE" ]; then echo "Usage: ./create-secret.sh <namespace>"; exit 1; fi

KEYS_DIR="$(cd "$(dirname "$0")" && pwd)/keys"
LAOQR_KEYS_DIR="$(cd "$(dirname "$0")" && pwd)/laoqr-keys"
b64() { base64 < "$1" | tr -d '\n'; }

DB_PASS_VAL="Panda>2026>WriteGateway1234567890>"
RABBITMQ_HOST="panda-rabbitmq.${NAMESPACE}.svc.cluster.local"
RABBITMQ_PORT="5672"
RABBITMQ_USER_VAL="user"
RABBITMQ_PASS_VAL="PVndAi2026iR3PP1"

REDIS_URL="redis://10.231.221.4:6379"

GATEWAY_PRIVATE_KEY="$(b64 "$KEYS_DIR/gateway.pem")"
ADMIN_PUBLIC_KEY="$(b64    "$KEYS_DIR/admin.pub")"
MOBILE_PUBLIC_KEY="$(b64   "$KEYS_DIR/mobile.pub")"

BCEL_PRIVATE_KEY="$(base64 -i "$KEYS_DIR/bcel-merchant.pem" | tr -d '\n')"
LAOQR_PRIVATE_KEY="$(base64 -i "$LAOQR_KEYS_DIR/laoqr-private.pem" | tr -d '\n')"

# LaoQR callback public key (DER hex) — provided by BCEL for callback signature verification.
# Source priority: file laoqr-keys/laoqr-callback.pub → env var LAOQR_CALLBACK_PUBLIC_KEY_HEX → empty (skips verification)
if [ -f "$LAOQR_KEYS_DIR/laoqr-callback.pub" ]; then
  LAOQR_CALLBACK_PUBLIC_KEY_HEX="$(openssl pkey -pubin -in "$LAOQR_KEYS_DIR/laoqr-callback.pub" -outform DER | xxd -p -c 256 | tr -d '\n')"
else
  LAOQR_CALLBACK_PUBLIC_KEY_HEX="${LAOQR_CALLBACK_PUBLIC_KEY_HEX:-}"
  if [ -z "$LAOQR_CALLBACK_PUBLIC_KEY_HEX" ]; then
    echo "WARN: laoqr-keys/laoqr-callback.pub not found and LAOQR_CALLBACK_PUBLIC_KEY_HEX not set — callback signature verification will be skipped."
  fi
fi

TRUSTED_KEYS="[{\"iss\":\"admin-api\",\"key\":\"${ADMIN_PUBLIC_KEY}\"},{\"iss\":\"mobile-api\",\"key\":\"${MOBILE_PUBLIC_KEY}\"}]"

kubectl delete secret panda-gateway-api-secrets --namespace=$NAMESPACE --ignore-not-found

kubectl create secret generic panda-gateway-api-secrets --namespace=$NAMESPACE \
  --from-literal=DATABASE_URL="postgresql://panda_gateway_user:${DB_PASS_VAL}@127.0.0.1:5432/panda_ev_core?schema=panda_ev_gateway&options=-c%20timezone%3DUTC" \
  --from-literal=RABBITMQ_URL="amqp://${RABBITMQ_USER_VAL}:${RABBITMQ_PASS_VAL}@${RABBITMQ_HOST}:${RABBITMQ_PORT}" \
  --from-literal=REDIS_URL="${REDIS_URL}" \
  --from-literal=SERVICE_JWT_PRIVATE_KEY="${GATEWAY_PRIVATE_KEY}" \
  --from-literal=TRUSTED_SERVICE_PUBLIC_KEYS="${TRUSTED_KEYS}" \
  --from-literal=BCEL_PRIVATE_KEY="${BCEL_PRIVATE_KEY}" \
  --from-literal=MOBILE_PUBLIC_KEY="${MOBILE_PUBLIC_KEY}" \
  --from-literal=LAOQR_PRIVATE_KEY="${LAOQR_PRIVATE_KEY}" \
  ${LAOQR_CALLBACK_PUBLIC_KEY_HEX:+--from-literal=LAOQR_CALLBACK_PUBLIC_KEY_HEX="${LAOQR_CALLBACK_PUBLIC_KEY_HEX}"}
